# 仅用于本机开发；复制为仓库根目录 .env。前端不读取此文件。
POSTGRES_USER=agent_app
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=agent_platform
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# 可选：覆盖上面的后端连接参数，须使用 postgresql+psycopg 驱动。
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database

# OpenRouter 兼容接口；填写 API Key 后重启后端。
MODEL_BASE_URL='https://openrouter.ai/api/v1'
MODEL_API_KEY=
MODEL_NAME='minimax/minimax-m3.1-flash:free'
# 初始化模型的演示费率（USD / 百万 token）；已有模型请在管理页面调价。
MODEL_INPUT_RATE='0.50'
MODEL_OUTPUT_RATE='2.00'
MODEL_CACHED_RATE='0.10'
MODEL_PRICE_SOURCE=''
MODEL_BILLING_NOTE='演示费率；实际调用 OpenRouter 免费接口，并非供应商实际扣费。'
MODEL_TIMEOUT='120'
